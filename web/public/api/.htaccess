# mail-config.php and admin-config.php hold passwords; mailer.php and catalog-store.php only
# shared code: none is ever served, even as source. data/ (the live catalogue) closes
# itself with its own .htaccess, written by catalog-store.php.
<FilesMatch "^(mail-config|mailer|admin-config|catalog-store)">
  Require all denied
</FilesMatch>
